# Copy to backend/.env (never commit .env). Every variable is optional.

# Google AI Studio key. Without it, SaansSafe uses its rule-based explanations.
GEMINI_API_KEY=
# Model is chosen at deploy time; no code change needed to switch.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=12
GEMINI_TEMPERATURE=0.3
# 0 turns off "thinking" for faster replies on Flash models.
GEMINI_THINKING_BUDGET=0

# Cache lifetimes in seconds
AIR_CACHE_TTL_S=1200
HISTORY_CACHE_TTL_S=3600
ARCHIVE_CACHE_TTL_S=86400
# The long-term archive is slow (up to a minute) and loads in the background.
ARCHIVE_TIMEOUT_S=120
AI_CACHE_TTL_S=900

# Rate limits per client IP
AI_RATE_LIMIT=20/minute
DATA_RATE_LIMIT=60/minute

# Accounts database. Set DATABASE_URL to a Postgres connection string (e.g. Supabase:
# Project > Connect > Session pooler, with your database password filled in). Leave it blank to
# use the SQLite file at DATABASE_PATH (mount a volume there to keep accounts).
AUTH_RATE_LIMIT=10/minute
DATABASE_URL=
DATABASE_PATH=data/saanssafe.db
SESSION_DAYS=7
# Set to false only for plain-http testing on a non-localhost address
COOKIE_SECURE=true

# Shared demo account, re-created with a sample family on every start (its password is public
# and shown on the log-in page). Set DEMO_ACCOUNT=false to turn it off.
DEMO_ACCOUNT=true
DEMO_EMAIL=demo@saanssafe.app
DEMO_PASSWORD=SaansSafe-Demo-2026

# Serve the built frontend from this folder (set automatically in Docker)
# STATIC_DIR=../frontend/dist
# Swagger UI at /docs (off by default in production)
ENABLE_API_DOCS=false
