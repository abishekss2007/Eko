# Copy to backend/.env (never commit .env). Every variable is optional.

# Google AI Studio key. Without it, SaansSafe uses its rule-based explanations.
GEMINI_API_KEY=
# Model is chosen at deploy time; no code change needed to switch.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=12
GEMINI_TEMPERATURE=0.3
# 0 turns off "thinking" for faster replies on Flash models.
GEMINI_THINKING_BUDGET=0

# Cache lifetimes in seconds
AIR_CACHE_TTL_S=1200
AI_CACHE_TTL_S=900

# Rate limits per client IP
AI_RATE_LIMIT=20/minute
DATA_RATE_LIMIT=60/minute

# Serve the built frontend from this folder (set automatically in Docker)
# STATIC_DIR=../frontend/dist
# Swagger UI at /docs (off by default in production)
ENABLE_API_DOCS=false
